    "policyTypes": [
      "Ingress"
    ]
  },
  "pod-0": {
    "metadata": {
      "name": "store-1-0",
      "namespace": "app",
      "labels": {
        "app.kubernetes.io/name": "redis",
        "redis.operator.com/cluster": "store",
        "redis.operator.com/instance": "store-1",
        "redis.operator.com/role": "primary"
      },
      "annotations": {
        "redis.operator.com/spec-hash": "99e902017d7d8001"
      }
    },
    "spec": {
      "volumes": [
        {
          "name": "controller",
          "emptyDir": {}
        },
        {
          "name": "kube-api-access",
          "projected": {
            "sources": [
              {
                "serviceAccountToken": {
                  "path": "token"
                }
              },
              {
                "configMap": {
                  "name": "kube-root-ca.crt",
                  "items": [
                    {
                      "key": "ca.crt",
                      "path": "ca.crt"
                    }
                  ]
                }
              },
              {
                "downwardAPI": {
                  "items": [
                    {
                      "path": "namespace",
                      "fieldRef": {
                        "fieldPath": "metadata.namespace"
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "internal-auth",
          "secret": {
            "secretName": "store-internal-auth"
          }
        },
        {
          "name": "data",
          "persistentVolumeClaim": {
            "claimName": "data-0"
          }
        },
        {
          "name": "certificates",
          "secret": {
            "secretName": "store-1-im-tls"
          }
        },
        {
          "name": "redis-tls",
          "secret": {
            "secretName": "store-1-server-tls"
          }
        }
      ],
      "initContainers": [
        {
          "name": "bootstrap",
          "image": "operator:v1",
          "command": [
            "/manager",
            "bootstrap",
            "/controller/manager"
          ],
          "resources": {},
          "volumeMounts": [
            {
              "name": "controller",
              "mountPath": "/controller"
            }
          ],
          "securityContext": {
            "capabilities": {
              "drop": [
                "ALL"
              ]
            },
            "allowPrivilegeEscalation": false
          }
        }
      ],
      "containers": [
        {
          "name": "redis",
          "image": "redis:7.2",
          "command": [
            "/controller/manager",
            "instance",
            "run",
            "--instance=store-1",
            "--databases=16",
            "--io-threads=1",
            "--cluster",
            "--tls"
          ],
          "ports": [
            {
              "name": "redis",
              "containerPort": 6379
            },
            {
              "name": "probes",
              "containerPort": 8001
            },
            {
              "name": "status",
              "containerPort": 8000
            },
            {
              "name": "cluster-bus",
              "containerPort": 16379
            }
          ],
          "env": [
            {
              "name": "POD_NAME",
              "valueFrom": {
                "fieldRef": {
                  "fieldPath": "metadata.name"
                }
              }
            },
            {
              "name": "POD_NAMESPACE",
              "valueFrom": {
                "fieldRef": {
                  "fieldPath": "metadata.namespace"
                }
              }
            }
          ],
          "resources": {
            "limits": {
              "memory": "256Mi"
            }
          },
          "volumeMounts": [
            {
              "name": "data",
              "mountPath": "/data"
            },
            {
              "name": "controller",
              "mountPath": "/controller"
            },
            {
              "name": "certificates",
              "readOnly": true,
              "mountPath": "/certificates"
            },
            {
              "name": "internal-auth",
              "readOnly": true,
              "mountPath": "/internal-auth"
            },
            {
              "name": "kube-api-access",
              "readOnly": true,
              "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount"
            },
            {
              "name": "redis-tls",
              "readOnly": true,
              "mountPath": "/tls"
            }
          ],
          "livenessProbe": {
            "httpGet": {
              "path": "/healthz",
              "port": 8001
            },
            "periodSeconds": 5
          },
          "readinessProbe": {
            "httpGet": {
              "path": "/readyz",
              "port": 8001
            },
            "periodSeconds": 5
          },
          "securityContext": {
            "capabilities": {
              "drop": [
                "ALL"
              ]
            },
            "allowPrivilegeEscalation": false
          }
        }
      ],
      "serviceAccountName": "store-1-instance",
      "automountServiceAccountToken": false,
      "securityContext": {
        "runAsUser": 999,
        "runAsNonRoot": true,
        "fsGroup": 999,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "hostname": "store-1-0",
      "subdomain": "store-1-hl",
      "affinity": {
        "podAntiAffinity": {
          "requiredDuringSchedulingIgnoredDuringExecution": [
            {
              "labelSelector": {
                "matchLabels": {
                  "redis.operator.com/instance": "store-1"
                }
              },
              "topologyKey": "kubernetes.io/hostname"
            }
          ]
        }
      }
    },
    "status": {}
  },
