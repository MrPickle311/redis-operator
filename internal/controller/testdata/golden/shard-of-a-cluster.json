      }
    },
    "ingress": [
      {
        "ports": [
          {
            "protocol": "TCP",
            "port": 6379
          }
        ]
      },
      {
        "ports": [
          {
            "protocol": "TCP",
            "port": 6379
          }
        ],
        "from": [
          {
            "podSelector": {
              "matchLabels": {
                "redis.operator.com/instance": "store-1"
              }
            }
          }
        ]
      },
      {
        "ports": [
          {
            "protocol": "TCP",
            "port": 8000
          }
        ],
        "from": [
          {
            "podSelector": {
              "matchLabels": {
                "app.kubernetes.io/name": "redis-operator",
                "control-plane": "controller-manager"
              }
            },
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "redis-operator-system"
              }
            }
          }
        ]
      },
      {
        "ports": [
          {
            "protocol": "TCP",
            "port": 8001
          }
        ]
      },
      {
        "ports": [
          {
            "protocol": "TCP",
            "port": 16379
          },
          {
            "protocol": "TCP",
            "port": 6379
          }
        ],
