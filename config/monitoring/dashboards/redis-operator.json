{
 "uid": "redis-operator-operator",
 "title": "Redis Operator / Operator",
 "description": "Reconciles, workqueues, API and Instance Manager calls, and decisions of the operator",
 "tags": [
  "redis-operator"
 ],
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "graphTooltip": 1,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "5s",
   "10s",
   "30s",
   "1m",
   "5m"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0
   },
   {
    "name": "loki",
    "label": "Loki",
    "type": "datasource",
    "query": "loki",
    "current": {},
    "hide": 0
   },
   {
    "name": "job",
    "label": "Operator",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "hide": 0,
    "query": {
     "query": "label_values(controller_runtime_reconcile_total, job)",
     "refId": "job"
    },
    "definition": "label_values(controller_runtime_reconcile_total, job)",
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "multi": false,
    "current": {}
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "name": "Alerts",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "max by (alertname, severity) (ALERTS{alertstate=\"firing\",alertname=~\"Redis.*\"})",
    "step": "15s",
    "titleFormat": "Alerts",
    "textFormat": "{{alertname}} ({{severity}})",
    "useValueForTime": false
   }
  ]
 },
 "panels": [
  {
   "type": "text",
   "title": "",
   "options": {
    "mode": "markdown",
    "content": "**How to read it.** The graph is the operator now: an arrow to every RedisInstance, RedisCluster and RedisUser with the calls to the Kubernetes API its reconciles made per minute, and an arrow to the Instance Managers of every instance with the HTTP calls per minute; a node shows the reconciles per minute. Below: the controllers of controller-runtime, their workqueues, every object, the calls to the API in time, the calls to the Instance Managers and the decisions."
   },
   "transparent": true,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Leader",
   "description": "This replica of the operator holds the leader lease and runs the controllers",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max(leader_election_master_status{job=~\"$job\"})",
     "legendFormat": "",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "leading",
         "color": "green",
         "index": 0
        },
        "0": {
         "text": "standby",
         "color": "orange",
         "index": 1
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 4,
    "h": 4
   },
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Reconciles per second",
   "description": "",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(controller_runtime_reconcile_total{job=~\"$job\"}[$__rate_interval]))",
     "legendFormat": "",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 4,
    "y": 3,
    "w": 4,
    "h": 4
   },
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Errors per second",
   "description": "Reconciles that returned an error and are retried with backoff",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(controller_runtime_reconcile_errors_total{job=~\"$job\"}[$__rate_interval]))",
     "legendFormat": "",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 8,
    "y": 3,
    "w": 4,
    "h": 4
   },
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Queued",
   "description": "Objects waiting in the workqueues of all controllers",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(workqueue_depth{job=~\"$job\"})",
     "legendFormat": "",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 12,
    "y": 3,
    "w": 4,
    "h": 4
   },
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Memory",
   "description": "",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(process_resident_memory_bytes{job=~\"$job\"})",
     "legendFormat": "",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 16,
    "y": 3,
    "w": 4,
    "h": 4
   },
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Goroutines",
   "description": "",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(go_goroutines{job=~\"$job\"})",
     "legendFormat": "",
     "refId": "A",
     "range": false,
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 20,
    "y": 3,
    "w": 4,
    "h": 4
   },
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "state-timeline",
   "title": "Alerts",
   "description": "Every alert of config/monitoring/prometheusrule.yaml, of every object; hover a bar for the labels. Nothing here: none fired.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (alertname) (ALERTS{alertstate=\"firing\",alertname=~\"Redis.*\"}) or (max by (alertname) (max_over_time((ALERTS{alertstate=\"firing\",alertname=~\"Redis.*\"})[$__range:15s])) * 0 - 1)",
     "legendFormat": "{{alertname}}",
     "refId": "A",
     "range": true
    }
   ],
   "interval": "5s",
   "options": {
    "mergeValues": true,
    "showValue": "auto",
    "alignValue": "center",
    "rowHeight": 0.85,
    "legend": {
     "showLegend": false
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "firing",
         "color": "red",
         "index": 0
        },
        "-1": {
         "text": " ",
         "color": "transparent",
         "index": 99
        }
       }
      }
     ],
     "custom": {
      "fillOpacity": 85,
      "lineWidth": 0,
      "insertNulls": 20000,
      "spanNulls": false
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 24,
    "h": 4
   },
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "nodeGraph",
   "title": "How the operator talks to its objects",
   "description": "Purple: the operator. Green: RedisInstances, orange: RedisClusters, blue: RedisUsers, with their reconciles per minute. Grey: the Instance Managers of an instance, which the operator calls over HTTP. Hover an arrow: calls per minute, to the Kubernetes API for an object, over HTTP for Instance Managers.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (id, title, subtitle, color) (label_replace(label_replace(label_replace(label_replace(60 * sum(rate(controller_runtime_reconcile_total{job=~\"$job\"}[$__rate_interval])), \"id\", \"operator\", \"\", \"\"), \"title\", \"redis-operator\", \"\", \"\"), \"subtitle\", \"operator\", \"\", \"\"), \"color\", \"purple\", \"\", \"\") or label_replace(label_replace(label_replace(label_join(label_join(label_replace(60 * sum by (kind, namespace, name) (rate(redis_operator_reconcile_total{kind!=\"\"}[$__rate_interval])), \"title\", \"$1\", \"name\", \"(.*)\"), \"id\", \"/\", \"kind\", \"namespace\", \"name\"), \"subtitle\", \" \u00b7 \", \"kind\", \"namespace\"), \"color\", \"green\", \"kind\", \"RedisInstance\"), \"color\", \"orange\", \"kind\", \"RedisCluster\"), \"color\", \"blue\", \"kind\", \"RedisUser\") or label_replace(label_replace(label_replace(label_join(label_join(60 * sum by (namespace, redis_instance) (rate(redis_operator_im_requests_total[$__rate_interval])), \"id\", \"/\", \"namespace\", \"redis_instance\"), \"title\", \" \", \"redis_instance\"), \"subtitle\", \"Instance Managers\", \"\", \"\"), \"color\", \"#8e8e8e\", \"\", \"\"), \"id\", \"im/$1\", \"id\", \"(.*)\"))",
     "refId": "A",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (id, source, target) (label_join(label_replace((label_join(60 * sum by (kind, namespace, name) (rate(redis_operator_api_requests_total{kind!=\"\"}[$__rate_interval])), \"target\", \"/\", \"kind\", \"namespace\", \"name\")) or (label_replace(label_join(60 * sum by (namespace, redis_instance) (rate(redis_operator_im_requests_total[$__rate_interval])), \"target\", \"/\", \"namespace\", \"redis_instance\"), \"target\", \"im/$1\", \"target\", \"(.*)\")), \"source\", \"operator\", \"\", \"\"), \"id\", \"->\", \"source\", \"target\"))",
     "refId": "B",
     "format": "table",
     "instant": true,
     "range": false
    }
   ],
   "transformations": [
    {
     "id": "calculateField",
     "options": {
      "mode": "reduceRow",
      "reduce": {
       "reducer": "sum"
      },
      "alias": "mainstat",
      "replaceFields": false,
      "timeSeries": false
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "Value #A": true,
       "Value #B": true
      }
     }
    }
   ],
   "options": {
    "nodes": {
     "mainStatUnit": "suffix: rec/min"
    },
    "edges": {
     "mainStatUnit": "suffix: calls/min"
    }
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 1
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 24,
    "h": 20
   },
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "row",
   "title": "Controllers (controller-runtime)",
   "collapsed": false,
   "id": 10,
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Reconciles per second, by controller and result",
   "description": "success: done; requeue_after: done, look again later (e.g. every 30 s, or 1 s while slots move); requeue: again at once; error: failed, retried with backoff",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (controller, result) (rate(controller_runtime_reconcile_total{job=~\"$job\"}[$__rate_interval]))",
     "legendFormat": "{{controller}} {{result}}",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Reconcile duration, by controller",
   "description": "A reconcile of a RedisCluster moving slots runs up to 5 s on purpose",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le, controller) (rate(controller_runtime_reconcile_time_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
     "legendFormat": "{{controller}} p50",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.95, sum by (le, controller) (rate(controller_runtime_reconcile_time_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
     "legendFormat": "{{controller}} p95",
     "refId": "B",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.99, sum by (le, controller) (rate(controller_runtime_reconcile_time_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
     "legendFormat": "{{controller}} p99",
     "refId": "C",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "id": 12,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Errors per second, by controller",
   "description": "Most are conflicts of a status update with a newer version, retried at once",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (controller) (rate(controller_runtime_reconcile_errors_total{job=~\"$job\"}[$__rate_interval]))",
     "legendFormat": "{{controller}}",
     "refId": "A",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 8,
    "h": 7
   },
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Workers busy, of the maximum",
   "description": "Reconciles running at once; one worker per controller, so a long one makes the others wait",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (controller) (controller_runtime_active_workers{job=~\"$job\"})",
     "legendFormat": "{{controller}} busy",
     "refId": "A",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (controller) (controller_runtime_max_concurrent_reconciles{job=~\"$job\"})",
     "legendFormat": "{{controller}} max",
     "refId": "B",
     "range": true
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 8,
    "y": 40,
    "w": 8,
    "h": 7
   },
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
