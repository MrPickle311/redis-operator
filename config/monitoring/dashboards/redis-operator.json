  {
   "type": "table",
   "title": "Every decision",
   "datasource": {
    "type": "loki",
    "uid": "${loki}"
   },
   "description": "One row per decision of the operator, from its log: switchovers and failovers with where from and to, Pods it created or replaced, approvals of a restarted primary, cluster commands, Events and errors. Blue: something starts, green: done, orange: an Event, red: an error.",
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "${loki}"
     },
     "expr": "{namespace=\"redis-operator-system\", container=\"manager\"} != `Moved slot` != `Could not configure` |~ `Started|Completed|Finished|Approved|Promot|Creating|Replacing|Switching|Deleting|Ran cluster|Updated Pod|Event occurred|Fenc|Demot|Recreat|Scal|Forget|Reconciler error` | regexp `^\\S+\\t(?P<level>\\S+)\\t(?:(?P<logger>events)\\t)?(?P<msg>[^\\t]+)\\t(?P<fields>\\{.*\\})$` | line_format `{{.fields}}` | json | label_format object=`{{ or .RedisInstance_name .RedisCluster_name .RedisUser_name .object_name }}`, what=`{{ or .controllerKind .kind }}`, where=`{{ or .RedisInstance_namespace .RedisCluster_namespace .RedisUser_namespace .object_namespace }}` | label_format decision=`{{ if .logger }}{{ .reason }}{{ else }}{{ .msg }}{{ end }}`, detail=`{{ if .logger }}{{ .note }}{{ else }}{{ if .outcome }}{{ .outcome }} {{ end }}{{ if .from }}{{ .from }} \u2192 {{ .to }} {{ end }}{{ if .epoch }}epoch {{ .epoch }} {{ end }}{{ if .durationMs }}{{ .durationMs }} ms {{ end }}{{ if .downMs }}primary down {{ .downMs }} ms {{ end }}{{ if .pod_extracted }}{{ .pod_extracted }} {{ end }}{{ if .command }}{{ .command }} on {{ .node }} {{ end }}{{ if .role }}{{ .name }} is {{ .role }} {{ end }}{{ if .reason }}{{ .reason }} {{ end }}{{ if and (not .role) (ne .name .object) }}{{ .name }} {{ end }}{{ if .error }}{{ .error }}{{ end }}{{ end }}` | keep what, where, object, decision, detail, level",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "transformations": [
    {
     "id": "extractFields",
     "options": {
      "source": "labels"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "labels": true,
       "Line": true,
       "tsNs": true,
       "id": true,
       "level": true
      },
      "indexByName": {
       "Time": 0,
       "what": 1,
       "where": 2,
       "object": 3,
       "decision": 4,
       "detail": 5
      },
      "renameByName": {
       "what": "Kind",
       "where": "Namespace",
       "object": "Object",
       "decision": "Decision",
       "detail": "Details"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Time",
        "desc": true
       }
      ]
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Decision"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "custom.width",
        "value": 260
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "regex",
          "options": {
           "pattern": "^(Reconciler error|.*Failed|.*Rejected|.*Blocked|Failover.*)$",
           "result": {
            "color": "red",
            "index": 0
           }
          }
         },
         {
          "type": "regex",
          "options": {
           "pattern": "^(Started.*|Switching.*|Creating.*|Replacing.*|Deleting.*|Ran cluster.*)$",
           "result": {
            "color": "blue",
            "index": 1
           }
          }
         },
         {
          "type": "regex",
          "options": {
           "pattern": "^(Completed.*|Finished.*|Approved.*|Updated.*|.*Completed|.*Balanced)$",
           "result": {
            "color": "green",
            "index": 2
           }
          }
         },
         {
          "type": "regex",
          "options": {
           "pattern": ".*",
           "result": {
            "color": "orange",
            "index": 3
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Time"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 190
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Kind"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 130
       }
      ]
     }
    ]
   },
   "gridPos": {
    "x": 0,
    "y": 117,
    "w": 24,
    "h": 14
   },
   "id": 37
  }
 ]
